# Copy to /etc/yunji/api.env with mode 0600. Never commit filled credentials.
YUNJI_PROFILE=prod
YUNJI_BIND_ADDRESS=127.0.0.1
YUNJI_API_PORT=18088
YUNJI_DB_URL=jdbc:mysql://127.0.0.1:3306/yunji?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
YUNJI_DB_USERNAME=yunji_app
YUNJI_DB_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
YUNJI_REDIS_HOST=127.0.0.1
YUNJI_REDIS_PORT=6379
YUNJI_REDIS_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
YUNJI_MONITOR_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD
YUNJI_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
YUNJI_STORAGE_ROOT=/var/lib/yunji/files
YUNJI_IDENTITY_HMAC_KEY=REPLACE_WITH_STABLE_RANDOM_KEY
YUNJI_IDENTITY_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
YUNJI_WECHAT_APP_ID=
YUNJI_WECHAT_SECRET=
# Required for production global file uploads and signed downloads; no local fallback.
YUNJI_WECHAT_CLOUD_ENV=
# Enable bounded soft archival after migration V26 and target acceptance.
YUNJI_HOT_ARCHIVE_SCHEDULER_ENABLED=false
YUNJI_HOT_ARCHIVE_POLL_MS=60000
# YUNJI_LOCAL_SECRET intentionally absent in production.

# Daily UTC 02:30 cleanup, only explicit deletions older than seven days and without references.
YUNJI_FILE_CLEANUP_ENABLED=true
