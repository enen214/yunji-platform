/* 悬浮玻璃底栏（Apple "Regular" 材质）：
   薄面纱 + 大半径背景模糊 + 提饱和 + 亮边 + 内环 + 落地影。
   面纱不能厚：厚了就不是玻璃，是一块白塑料板。
   顺序不能乱：外层负责定位和安全区，内层负责材质。 */
.tb-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 10px;
  padding-bottom: calc(10px + constant(safe-area-inset-bottom));
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tb {
  position: relative;
  pointer-events: auto;
  box-sizing: border-box;
  height: 68px;
  display: flex;
  align-items: stretch;
  /* 圆角 = 高/2 = 32，真胶囊。26 是圆角矩形，和 Apple 的浮动条一比就"方"了 */
  border-radius: 34px;
  /* 玻璃是"上沿受光更亮、下沿更透"，不是一块均匀的奶白层；
     均匀面纱不管降到多少都还是塑料。所以用 180° 渐变 + brightness 提光。
     饱和度不能拉满：240% 会把背后一小块深色封面放大成"蓝色贴纸"，150% 才是雾化透色。 */
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.26));
  border: 1px solid rgba(255, 255, 255, 0.7);
  -webkit-backdrop-filter: blur(30px) saturate(150%) brightness(1.12);
  backdrop-filter: blur(30px) saturate(150%) brightness(1.12);
  box-shadow:
    inset 1px 0 0 rgba(255, 255, 255, 0.55),
    inset -1px 0 0 rgba(255, 255, 255, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    inset 0 -1px 0 rgba(255, 255, 255, 0.4),
    inset 0 0 0 1px rgba(24, 74, 52, 0.04),
    0 1px 2px rgba(24, 74, 52, 0.07),
    0 20px 44px -18px rgba(24, 74, 52, 0.4);
}

/* 药丸必须与条带同心：条半径 32 = 内边距 5 + 药丸半径 27。
   不同心的话，左端选中时药丸的弧和条带的弧会交叉，一眼就不像 iOS。 */
.tb-pill {
  position: absolute;
  left: 5px;
  top: 5px;
  bottom: 5px;
  z-index: 0;
  border-radius: 29px;
  background: rgba(255, 255, 255, 0.55);
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.75),
    inset 0 1px 0 rgba(255, 255, 255, 0.92),
    inset 0 -1px 0 rgba(255, 255, 255, 0.45),
    0 1px 2px rgba(24, 74, 52, 0.09),
    0 3px 10px -3px rgba(24, 74, 52, 0.16),
    0 6px 16px -10px rgba(24, 74, 52, 0.3);
  transition: transform 440ms cubic-bezier(0.34, 1.4, 0.64, 1);
}

/* 不支持背景模糊的机型（部分安卓）：把面纱加厚到接近实色。
   底栏是 fixed 压在所有内容上的，90% 仍会透出深色封面，故提到 96%。 */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .tb {
    background: rgba(252, 254, 253, 0.96);
  }
}

/* Apple Music 式按压：按下缩进去，松手用带过冲的弹簧曲线弹回来 */
.tb-item {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  transform-origin: 50% 62%;
  transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 180ms ease-out;
}

.tb-item-hover {
  transform: scale(0.84);
  opacity: 0.66;
  transition-duration: 90ms;
  transition-timing-function: cubic-bezier(0.28, 0.9, 0.3, 1);
}

.tb-icon {
  width: 27px;
  height: 27px;
  display: block;
  transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tb-item-hover .tb-icon {
  transform: translateY(1.5px) scale(0.9);
  transition-duration: 90ms;
}

.tb-label {
  font-size: 10.5px;
  line-height: 1.1;
  letter-spacing: 0.01em;
  color: #5F7167;
  text-shadow: 0 1px 1px rgba(255, 255, 255, 0.62);
  transition: color 200ms ease-out, transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tb-label.on {
  color: #2e6b4f;
  font-weight: 600;
}
